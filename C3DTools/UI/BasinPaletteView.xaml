<UserControl x:Class="C3DTools.UI.BasinPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:C3DTools.UI"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="300"
             Background="#1E1E1E" Foreground="#D4D4D4" FontSize="12">

    <UserControl.Resources>

        <!-- Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <local:StringEqualityConverter x:Key="StringEqualityConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="BgPrimary"     Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgSurface"     Color="#252526"/>
        <SolidColorBrush x:Key="BgInput"       Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BorderMuted"   Color="#3A3A3A"/>
        <SolidColorBrush x:Key="BorderInput"   Color="#3D3D3D"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E8E8E8"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#B8B8B8"/>
        <SolidColorBrush x:Key="TextDim"       Color="#9A9A9A"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#0E639C"/>
        <SolidColorBrush x:Key="AccentTeal"    Color="#4EC9B0"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#3D8B3D"/>
        <SolidColorBrush x:Key="AccentAmber"   Color="#C4A882"/>
        <SolidColorBrush x:Key="AccentRed"     Color="#F48771"/>
        <SolidColorBrush x:Key="AccentYellow"  Color="#DCDCAA"/>
        <SolidColorBrush x:Key="HoverBlue"     Color="#2A3A4A"/>
        <SolidColorBrush x:Key="ActiveBlue"    Color="#1A3A5C"/>
        <SolidColorBrush x:Key="HoverGreen"    Color="#1E2E1E"/>
        <SolidColorBrush x:Key="Separator"     Color="#252525"/>

        <!-- Base TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Label (uppercase section header) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Group label (amber, settings subheadings) -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentAmber}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,7,0,3"/>
        </Style>

        <!-- Muted value text -->
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Teal ID text -->
        <Style x:Key="IdText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Monospace command text -->
        <Style x:Key="CommandText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentYellow}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Command description text -->
        <Style x:Key="CommandDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- ComboBox with dark popup -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"    Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TgBorder"
                                                Background="{StaticResource BgInput}"
                                                BorderBrush="{StaticResource BorderInput}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Width="22"
                                                        Background="Transparent">
                                                    <TextBlock Text="▾"
                                                               Foreground="{StaticResource TextMuted}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"/>
                                                </Border>
                                                <ContentPresenter/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TgBorder" Property="BorderBrush" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="7,4,24,4"
                                              VerticalAlignment="Center"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                                  RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource BgInput}"
                                        BorderBrush="{StaticResource BorderInput}"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem dark theme -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding"     Value="7,5"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="CiBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CiBorder" Property="Background"
                                        Value="{StaticResource HoverBlue}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CiBorder" Property="Background"
                                        Value="{StaticResource ActiveBlue}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button (blue) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A4F80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button (dark surface) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button (small square, refresh etc.) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (red border, for remove) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox base -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ListBoxItem base -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource Separator}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBlue}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ActiveBlue}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2,0,0,1"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="Background" Value="{StaticResource BgSurface}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentTeal}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                <Setter Property="Background" Value="{StaticResource BgSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command row button -->
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderMuted}"
            BorderThickness="1">
        <DockPanel>

            <!-- ═══ PANEL HEADER ═══ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="0,0,0,1"
                    Padding="10,7">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="C3D Tools"
                               Foreground="{StaticResource TextDim}" FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Basin Palette"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ═══ SELECTED BASIN STRIP (persistent) ═══ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    Visibility="{Binding SelectedBasin, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel>
                    <!-- Basin ID badge -->
                    <Border DockPanel.Dock="Left"
                            Background="{StaticResource ActiveBlue}"
                            BorderBrush="{StaticResource AccentBlue}"
                            BorderThickness="1"
                            Padding="7,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedBasin.BasinId}"
                                   Foreground="{StaticResource AccentTeal}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="{StaticResource TextDim}">
                            <Run Text="{Binding SelectedBasin.Layer, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="Handle "/>
                            <Run Text="{Binding SelectedBasin.ObjectId.Handle, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                             <Run Text="{Binding SelectedDevelopment, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- No selection placeholder -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    Visibility="{Binding SelectedBasin, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <TextBlock Text="No basin selected" FontSize="10"
                           Foreground="{StaticResource TextDim}" FontStyle="Italic"/>
            </Border>

            <!-- ═══ TAB BAR ═══ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BgPrimary}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="0,0,0,1">
                <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource TabButton}" Content="Basins"
                                 IsChecked="True"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Basins"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Landuses"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Landuses"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Hydrographs"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Hydrographs"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Ponds"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Ponds"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Results"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Results"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Masks"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Masks"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Settings"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Settings"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Commands"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Commands"/>
                </UniformGrid>
            </Border>

            <!-- ═══ TAB CONTENT ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding}">
                    <ContentControl.Resources>

                        <!-- ─── BASINS TAB ─── -->
                        <DataTemplate x:Key="BasinsTab">
                            <StackPanel>
                                <!-- Edit Selected -->
                                <Border BorderBrush="{StaticResource Separator}"
                                        BorderThickness="0,0,0,1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="EDIT SELECTED" Style="{StaticResource SectionLabel}"
                                                   Margin="0,0,0,7"/>
                                        <TextBlock Text="Basin ID" Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewBasinId, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"/>
                                        <TextBlock Text="Development" Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding DevelopmentOptions}"
                                                  SelectedItem="{Binding SelectedDevelopment, Mode=TwoWay}"
                                                  Margin="0,0,0,0"/>

                                        <TextBlock Text="HYDROLOGY INPUTS" Style="{StaticResource SectionLabel}"
                                                   Margin="0,12,0,7"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Curve number" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedCurveNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Tc (min)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedTcMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{Binding TagButtonText}"
                                                    Command="{Binding TagBasinCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="2"
                                                    Content="Untag"
                                                    Command="{Binding UntagBasinCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="Remove basin tag from selected polyline"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Sub-tab bar: Tagged / Untagged -->
                                <Border Background="{StaticResource BgPrimary}"
                                        BorderBrush="{StaticResource BorderMuted}"
                                        BorderThickness="0,0,0,1">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource TabButton}" Content="Tagged"
                                                     IsChecked="{Binding BasinsSubTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Tagged}"
                                                     Command="{Binding SwitchBasinsSubTabCommand}" CommandParameter="Tagged"
                                                     GroupName="BasinsSubTabs"/>
                                        <RadioButton Style="{StaticResource TabButton}" Content="Untagged"
                                                     IsChecked="{Binding BasinsSubTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Untagged}"
                                                     Command="{Binding SwitchBasinsSubTabCommand}" CommandParameter="Untagged"
                                                     GroupName="BasinsSubTabs"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Sub-tab content -->
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Resources>

                                        <!-- Tagged sub-tab -->
                                        <DataTemplate x:Key="TaggedSubTab">
                                            <StackPanel Margin="10">
                                                <DockPanel Margin="0,0,0,7">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="↻"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding RefreshCommand}"
                                                            ToolTip="Refresh"/>
                                                    <TextBlock Text="TAGGED BASINS" Style="{StaticResource SectionLabel}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <!-- Column headers -->
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.5*"/>
                                                        <ColumnDefinition Width="0.9*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="ID"    FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="DEV"   FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="LAYER" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                                </Grid>

                                                <ListBox ItemsSource="{Binding TaggedBasins}"
                                                         SelectedItem="{Binding SelectedTaggedBasin}"
                                                         MinHeight="80" MaxHeight="280">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,5,2,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="0.5*"/>
                                                                    <ColumnDefinition Width="0.9*"/>
                                                                    <ColumnDefinition Width="1.1*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding BasinId}"
                                                                           Style="{StaticResource IdText}" Padding="6,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Development}"
                                                                           Style="{StaticResource MutedText}" Padding="4,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Layer}"
                                                                           Style="{StaticResource MutedText}" Padding="4,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="{Binding TaggedBasins.Count, StringFormat='Count: {0}'}"
                                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Untagged sub-tab -->
                                        <DataTemplate x:Key="UntaggedSubTab">
                                            <StackPanel Margin="10">
                                                <DockPanel Margin="0,0,0,7">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="↻"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding RefreshCommand}"
                                                            ToolTip="Refresh"/>
                                                    <TextBlock Text="UNTAGGED BASINS" Style="{StaticResource SectionLabel}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Left" Text="Layer"
                                                               FontSize="11" Foreground="{StaticResource TextDim}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox ItemsSource="{Binding AvailableLayers}"
                                                              SelectedItem="{Binding SelectedLayer}"/>
                                                </DockPanel>

                                                <ListBox ItemsSource="{Binding UntaggedBasins}"
                                                         SelectedItem="{Binding SelectedUntaggedBasin}"
                                                         MinHeight="80" MaxHeight="280">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="8,5">
                                                                <TextBlock Text="{Binding Handle}"
                                                                           Foreground="#9CDCFE" FontSize="11"/>
                                                                <TextBlock Text="{Binding Layer}"
                                                                           Foreground="{StaticResource TextDim}" FontSize="10"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="{Binding UntaggedBasins.Count, StringFormat='Count: {0}'}"
                                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>

                                    </ContentControl.Resources>

                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BasinsSubTab}" Value="Tagged">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TaggedSubTab}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BasinsSubTab}" Value="Untagged">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource UntaggedSubTab}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── UNTAGGED TAB (removed - merged into Basins) ─── -->

                        <!-- ─── LANDUSES TAB ─── -->
                        <DataTemplate x:Key="LandusesTab">
                            <StackPanel Margin="10">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right"
                                            Content="↻"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding RefreshLandusesCommand}"
                                            ToolTip="Refresh layers"/>
                                    <TextBlock Text="HATCH LAYERS" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Select layers to include as landuses in CN calculations."
                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                           FontStyle="Italic" TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <!-- Filter search box -->
                                <TextBox Text="{Binding LanduseLayerFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,7">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Filter layers..."
                                                                               Foreground="#444444"
                                                                               FontSize="11"
                                                                               Margin="6,4"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Show selected only toggle -->
                                <CheckBox Content="Show selected only"
                                          IsChecked="{Binding ShowOnlySelected, Mode=TwoWay}"
                                          Margin="0,0,0,7"
                                          Foreground="{StaticResource TextMuted}"
                                          FontSize="11"/>

                                <!-- Layer list with checkboxes -->
                                <ListBox ItemsSource="{Binding FilteredLanduseLayers}"
                                         MinHeight="80" MaxHeight="300"
                                         SelectionMode="Single">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{StaticResource Separator}"
                                                                BorderThickness="0,0,0,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource HoverBlue}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="8,5">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding HatchCount}"
                                                           Foreground="{StaticResource TextDim}"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <TextBlock Text="{Binding LayerName}"
                                                           FontSize="11" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Summary row -->
                                <DockPanel Margin="0,5,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Content="Clear all"
                                            Command="{Binding ClearLanduseSelectionsCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="6,2" FontSize="10"/>
                                    <TextBlock Text="{Binding SelectedLanduseCount, StringFormat={}{0} layers selected}"
                                               Foreground="{StaticResource TextDim}" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── HYDROGRAPHS TAB ─── -->
                        <DataTemplate x:Key="HydrographsTab">
                            <StackPanel Margin="10">
                                <DockPanel Margin="0,0,0,7">
                                    <Button DockPanel.Dock="Right"
                                            Content="↻"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding RefreshCommand}"
                                            ToolTip="Refresh hydrographs"/>
                                    <TextBlock Text="HYDROGRAPHS" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HYD" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="TYPE" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="BASIN" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="INFLOWS" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding HydrographRows}"
                                         SelectedItem="{Binding SelectedHydrographRow}"
                                         MinHeight="120" MaxHeight="250">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.5*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                           Style="{StaticResource IdText}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Type}"
                                                           Style="{StaticResource MutedText}" Padding="4,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BasinId}"
                                                           Style="{StaticResource MutedText}" Padding="4,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding InflowIdsText}"
                                                           Style="{StaticResource MutedText}" Padding="4,0"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Add row"
                                            Command="{Binding AddHydrographRowCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding RemoveHydrographRowCommand}"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>

                                <Border BorderBrush="{StaticResource Separator}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,10,0,0" Padding="0,10,0,0"
                                        Visibility="{Binding SelectedHydrographRow, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="EDIT SELECTED" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hyd No." Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedHydrographRow.Id, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding HydrographTypeOptions}"
                                                          SelectedItem="{Binding SelectedHydrographRow.Type, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Basin / origin" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AvailableHydrographBasins}"
                                                  SelectedValuePath="BasinId"
                                                  SelectedValue="{Binding SelectedHydrographRow.BasinId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Inflow Hyd(s)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <ToggleButton x:Name="InflowPickerButton"
                                                      Background="{StaticResource BgInput}"
                                                      Foreground="{StaticResource TextPrimary}"
                                                      BorderBrush="{StaticResource BorderInput}"
                                                      BorderThickness="1"
                                                      Padding="6,4"
                                                      FontSize="11"
                                                      HorizontalContentAlignment="Stretch"
                                                      Margin="0,0,0,0">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="▾"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding SelectedHydrographRow.InflowIdsDisplay}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </ToggleButton>
                                        <Popup PlacementTarget="{Binding ElementName=InflowPickerButton}"
                                               IsOpen="{Binding IsChecked, ElementName=InflowPickerButton, Mode=TwoWay}"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Width="{Binding ActualWidth, ElementName=InflowPickerButton}"
                                                    MaxHeight="170"
                                                    Background="{StaticResource BgInput}"
                                                    BorderBrush="{StaticResource BorderInput}"
                                                    BorderThickness="1">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding AvailableInflowRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Content="{Binding DisplayText}"
                                                                          Foreground="{StaticResource TextMuted}"
                                                                          FontSize="11"
                                                                          Margin="7,5"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>

                                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SelectedHydrographRow.Description, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Regenerate"
                                            Command="{Binding RegenerateHydrographRowsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Content="Save rows"
                                            Command="{Binding SaveHydrographRowsCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── PONDS TAB ─── -->
                        <DataTemplate x:Key="PondsTab">
                            <StackPanel Margin="10">
                                <DockPanel Margin="0,0,0,7">
                                    <Button DockPanel.Dock="Right"
                                            Content="↻"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding RefreshCommand}"
                                            ToolTip="Refresh ponds"/>
                                    <TextBlock Text="PONDS" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HYD" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="POND" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="INFLOW" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="DESCRIPTION" FontSize="10" Foreground="#707070" Padding="2,0" FontWeight="SemiBold"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding PondRows}"
                                         SelectedItem="{Binding SelectedPondRow}"
                                         MinHeight="100" MaxHeight="210">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.5*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                           Style="{StaticResource IdText}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PondName}"
                                                           Style="{StaticResource MutedText}" Padding="4,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding InflowIdsText}"
                                                           Style="{StaticResource MutedText}" Padding="4,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Description}"
                                                           Style="{StaticResource MutedText}" Padding="4,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Add pond"
                                            Command="{Binding AddPondRowCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding RemovePondRowCommand}"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>

                                <Border BorderBrush="{StaticResource Separator}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,10,0,0" Padding="0,10,0,0"
                                        Visibility="{Binding SelectedPondRow, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="EDIT SELECTED" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hyd No." Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedPondRow.Id, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Pond ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedPondRow.PondName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Inflow Hyd" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <ToggleButton x:Name="PondInflowPickerButton"
                                                      Background="{StaticResource BgInput}"
                                                      Foreground="{StaticResource TextPrimary}"
                                                      BorderBrush="{StaticResource BorderInput}"
                                                      BorderThickness="1"
                                                      Padding="6,4"
                                                      FontSize="11"
                                                      HorizontalContentAlignment="Stretch"
                                                      Margin="0,0,0,6">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="▾"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding SelectedPondRow.InflowIdsDisplay}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </ToggleButton>
                                        <Popup PlacementTarget="{Binding ElementName=PondInflowPickerButton}"
                                               IsOpen="{Binding IsChecked, ElementName=PondInflowPickerButton, Mode=TwoWay}"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Width="{Binding ActualWidth, ElementName=PondInflowPickerButton}"
                                                    MaxHeight="170"
                                                    Background="{StaticResource BgInput}"
                                                    BorderBrush="{StaticResource BorderInput}"
                                                    BorderThickness="1">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding AvailableInflowRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Content="{Binding DisplayText}"
                                                                          Foreground="{StaticResource TextMuted}"
                                                                          FontSize="11"
                                                                          Margin="7,5"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>

                                        <TabControl Margin="0,2,0,8"
                                                    Background="{StaticResource BgSurface}"
                                                    BorderBrush="{StaticResource BorderMuted}"
                                                    Foreground="{StaticResource TextPrimary}">
                                            <TabControl.Resources>
                                                <Style TargetType="TabItem">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    <Setter Property="Background" Value="{StaticResource BgPrimary}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                                    <Setter Property="Padding" Value="10,5"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TabItem">
                                                                <Border x:Name="TabBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="1,1,1,0"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter ContentSource="Header"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgSurface}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TabControl.Resources>
                                            <TabItem Header="Storage">
                                                <StackPanel Margin="8" Background="{StaticResource BgSurface}">
                                                    <Border BorderBrush="{StaticResource BorderMuted}"
                                                            BorderThickness="1"
                                                            Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <Grid Background="#3388C6" MinHeight="30">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="0.45*"/>
                                                                    <ColumnDefinition Width="1.2*"/>
                                                                    <ColumnDefinition Width="1.2*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="#" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="Elevation (ft)" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="Volume (cu ft)" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding SelectedPondRow.StageStorageRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid MinHeight="24">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="0.45*"/>
                                                                                <ColumnDefinition Width="1.2*"/>
                                                                                <ColumnDefinition Width="1.2*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,1,1" Background="{StaticResource BgSurface}">
                                                                                <TextBlock Text="{Binding RowNumber}" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBox Grid.Column="1" Text="{Binding Elevation, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                            <TextBox Grid.Column="2" Text="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,0,1"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </TabItem>

                                            <TabItem Header="Outlet">
                                                <StackPanel Margin="8" Background="{StaticResource BgSurface}">
                                        <Border BorderBrush="{StaticResource BorderMuted}"
                                                BorderThickness="1"
                                                Margin="0,2,0,8">
                                            <StackPanel>
                                                <Border Background="{StaticResource BgPrimary}" Padding="7,5">
                                                    <TextBlock Text="CULVERTS / ORIFICES" Style="{StaticResource SectionLabel}"/>
                                                </Border>
                                                <Grid Background="#3388C6" MinHeight="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.35*"/>
                                                        <ColumnDefinition Width="0.55*"/>
                                                        <ColumnDefinition Width="0.55*"/>
                                                        <ColumnDefinition Width="0.55*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Culv/Orifice" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="A" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="B" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="C" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Grid.ColumnSpan="2" Text="Pri Riser" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SelectedPondRow.CulvertOrificeRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="24">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.35*"/>
                                                                    <ColumnDefinition Width="0.55*"/>
                                                                    <ColumnDefinition Width="0.55*"/>
                                                                    <ColumnDefinition Width="0.55*"/>
                                                                    <ColumnDefinition Width="1.1*"/>
                                                                    <ColumnDefinition Width="0.8*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,1,1" Background="{StaticResource BgSurface}">
                                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0"/>
                                                                </Border>
                                                                <TextBox Grid.Column="1" Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                <TextBox Grid.Column="2" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                <TextBox Grid.Column="3" Text="{Binding C, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                <Border Grid.Column="4" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,1,1" Background="{StaticResource BgSurface}">
                                                                    <TextBlock Text="{Binding RiserLabel}" FontSize="10" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0"/>
                                                                </Border>
                                                                <TextBox Grid.Column="5" Text="{Binding Riser, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,0,1"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{StaticResource BorderMuted}"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <Border Background="{StaticResource BgPrimary}" Padding="7,5">
                                                    <TextBlock Text="WEIRS" Style="{StaticResource SectionLabel}"/>
                                                </Border>
                                                <Grid Background="#3388C6" MinHeight="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.35*"/>
                                                        <ColumnDefinition Width="0.55*"/>
                                                        <ColumnDefinition Width="0.55*"/>
                                                        <ColumnDefinition Width="0.55*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Weir" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="A" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="B" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="C" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="D" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SelectedPondRow.WeirRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="24">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.35*"/>
                                                                    <ColumnDefinition Width="0.55*"/>
                                                                    <ColumnDefinition Width="0.55*"/>
                                                                    <ColumnDefinition Width="0.55*"/>
                                                                    <ColumnDefinition Width="1.25*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,1,1" Background="{StaticResource BgSurface}">
                                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0"/>
                                                                </Border>
                                                                <ContentControl Grid.Column="1" Content="{Binding}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <TextBox Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsWeirTypeRow}" Value="True">
                                                                                    <Setter Property="ContentTemplate">
                                                                                        <Setter.Value>
                                                                                            <DataTemplate>
                                                                                                <ComboBox ItemsSource="{Binding AWeirTypeOptions}" SelectedItem="{Binding A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,0" BorderThickness="0,0,1,1"/>
                                                                                            </DataTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                </ContentControl>
                                                                <ContentControl Grid.Column="2" Content="{Binding}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <TextBox Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsWeirTypeRow}" Value="True">
                                                                                    <Setter Property="ContentTemplate">
                                                                                        <Setter.Value>
                                                                                            <DataTemplate>
                                                                                                <ComboBox ItemsSource="{Binding WeirTypeOptions}" SelectedItem="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,0" BorderThickness="0,0,1,1"/>
                                                                                            </DataTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                </ContentControl>
                                                                <ContentControl Grid.Column="3" Content="{Binding}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <TextBox Text="{Binding C, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,1,1"/>
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsWeirTypeRow}" Value="True">
                                                                                    <Setter Property="ContentTemplate">
                                                                                        <Setter.Value>
                                                                                            <DataTemplate>
                                                                                                <ComboBox ItemsSource="{Binding WeirTypeOptions}" SelectedItem="{Binding C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,0" BorderThickness="0,0,1,1"/>
                                                                                            </DataTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                </ContentControl>
                                                                <ContentControl Grid.Column="4" Content="{Binding}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <TextBox Text="{Binding D, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,1" HorizontalContentAlignment="Center" BorderThickness="0,0,0,1"/>
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsWeirTypeRow}" Value="True">
                                                                                    <Setter Property="ContentTemplate">
                                                                                        <Setter.Value>
                                                                                            <DataTemplate>
                                                                                                <ComboBox ItemsSource="{Binding WeirTypeOptions}" SelectedItem="{Binding D, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="2,0" BorderThickness="0,0,0,1"/>
                                                                                            </DataTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                </ContentControl>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tailwater Elevation (ft)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedPondRow.TailwaterElevation, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Exfiltration Rate (in/hr)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedPondRow.ExfiltrationRate, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Exfiltration Applies To" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedPondRow.ExfiltrationApplyTo, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Extract from Outflow Hyd" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding SelectedPondRow.ExfiltrationExtractFromOutflowHyd, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Outlet notes" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SelectedPondRow.OutletStructureText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="42"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,6"/>

                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>

                                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SelectedPondRow.Description, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="Save ponds"
                                        Command="{Binding SavePondRowsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── RESULTS TAB ─── -->
                        <DataTemplate x:Key="ResultsTab">
                            <StackPanel Margin="10">
                                <DockPanel Margin="0,0,0,7">
                                    <Button DockPanel.Dock="Right"
                                            Content="↻"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding RefreshHydrologyResultsCommand}"
                                            ToolTip="Refresh hydrology results"/>
                                    <TextBlock Text="HYDROGRAPH RETURN PERIOD RECAP" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="{Binding ResultsStatus}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel MinWidth="760">
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="HYD" FontSize="10" Foreground="#707070" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="TYPE" FontSize="10" Foreground="#707070" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="INFLOW" FontSize="10" Foreground="#707070" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="1-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="2-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="5-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="10-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Text="25-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="8" Text="50-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="9" Text="100-YR" FontSize="10" Foreground="#707070" FontWeight="SemiBold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="10" Text="DESCRIPTION" FontSize="10" Foreground="#707070" FontWeight="SemiBold" Padding="8,0,0,0"/>
                                        </Grid>

                                        <ListBox ItemsSource="{Binding HydrographResultRows}" MinHeight="120" MaxHeight="430">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="160"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding HydNo}" Style="{StaticResource IdText}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource MutedText}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding InflowHyds}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Q1}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Q2}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding Q5}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding Q10}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding Q25}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="8" Text="{Binding Q50}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="9" Text="{Binding Q100}" Style="{StaticResource MutedText}" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="10" Text="{Binding Description}" Style="{StaticResource MutedText}" Padding="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── MASKS TAB ─── -->
                        <DataTemplate x:Key="MasksTab">
                            <StackPanel DataContext="{Binding MasksViewModel}">

                                <!-- ── Add new mask form ── -->
                                <Border BorderBrush="{StaticResource Separator}"
                                        BorderThickness="0,0,0,1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="ADD MASK" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>

                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewMaskName, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"/>

                                        <TextBlock Text="Layer prefix" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewLayerPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Inside label" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NewInsideLabel, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Outside label" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NewOutsideLabel, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Layer preview -->
                                        <Border Background="{StaticResource BgSurface}"
                                                BorderBrush="{StaticResource BorderMuted}"
                                                BorderThickness="1" Padding="6,5" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding NewInsideLayerPreview}"
                                                           Foreground="#81C784" FontSize="10" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding NewOutsideLayerPreview}"
                                                           Foreground="{StaticResource AccentRed}" FontSize="10" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Border>

                                        <CheckBox Content="Generate geometry when SPLITBASINS runs"
                                                  IsChecked="{Binding NewGenerateGeometry, Mode=TwoWay}"
                                                  Foreground="{StaticResource TextMuted}" FontSize="11"
                                                  Margin="0,0,0,8"/>

                                        <!-- Pick status -->
                                        <Border Background="{StaticResource BgSurface}"
                                                BorderBrush="{StaticResource BorderMuted}"
                                                BorderThickness="1" Padding="6,4" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding PendingHandleDisplay}"
                                                       Foreground="{StaticResource AccentAmber}"
                                                       FontSize="10" FontFamily="Consolas"/>
                                        </Border>

                                        <DockPanel>
                                            <Button DockPanel.Dock="Left"
                                                    Content="Pick polyline"
                                                    Command="{Binding PickPolylineCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="Add mask"
                                                    Command="{Binding AddMaskCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Stretch"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── Mask list ── -->
                                <StackPanel Margin="10">
                                    <DockPanel Margin="0,0,0,7">
                                        <Button DockPanel.Dock="Right"
                                                Content="↻" Style="{StaticResource IconButton}"
                                                Command="{Binding RefreshCommand}" ToolTip="Refresh"/>
                                        <TextBlock Text="SAVED MASKS" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <ListBox ItemsSource="{Binding Masks}"
                                             SelectedItem="{Binding SelectedMask}"
                                             MinHeight="60" MaxHeight="300">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <DockPanel>
                                                            <!-- Generate geometry indicator -->
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="⚙"
                                                                       Foreground="{StaticResource AccentTeal}"
                                                                       FontSize="10"
                                                                       ToolTip="Generate geometry enabled"
                                                                       Margin="4,0,0,0"
                                                                       Visibility="{Binding GenerateGeometry, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource IdText}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding InsideLayerName}"
                                                                   Foreground="#81C784" FontSize="10" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding OutsideLayerName}"
                                                                   Foreground="{StaticResource AccentRed}" FontSize="10" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Edit selected mask -->
                                    <Border Margin="0,8,0,0"
                                            Visibility="{Binding SelectedMask, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="EDIT SELECTED" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>

                                            <TextBlock Text="Layer prefix" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedMask.LayerPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,6"/>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Inside label" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding SelectedMask.InsideLabel, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Outside label" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding SelectedMask.OutsideLabel, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox Content="Generate geometry when SPLITBASINS runs"
                                                      IsChecked="{Binding SelectedMask.GenerateGeometry, Mode=TwoWay}"
                                                      Foreground="{StaticResource TextMuted}" FontSize="11"
                                                      Margin="0,0,0,8"/>

                                            <Border Background="{StaticResource BgSurface}"
                                                    BorderBrush="{StaticResource BorderMuted}"
                                                    BorderThickness="1" Padding="6,5" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedMask.InsideLayerName}"
                                                               Foreground="#81C784" FontSize="10" FontFamily="Consolas"/>
                                                    <TextBlock Text="{Binding SelectedMask.OutsideLayerName}"
                                                               Foreground="{StaticResource AccentRed}" FontSize="10" FontFamily="Consolas"/>
                                                </StackPanel>
                                            </Border>

                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Remove"
                                                        Command="{Binding RemoveMaskCommand}"
                                                        Style="{StaticResource DangerButton}"
                                                        Margin="6,0,0,0"/>
                                                <Button Content="Save changes"
                                                        Command="{Binding SaveMaskChangesCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        HorizontalAlignment="Stretch"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Run split hint -->
                                    <Border Background="{StaticResource BgSurface}"
                                            BorderBrush="{StaticResource BorderMuted}"
                                            BorderThickness="1" Padding="8,6"
                                            Margin="0,12,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="10"
                                                   Foreground="{StaticResource TextDim}">
                                            To generate split geometry, enable "Generate geometry" on a mask,
                                            then run SPLITBASINS from the Commands tab or the command line.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── SETTINGS TAB ─── -->
                        <DataTemplate x:Key="SettingsTab">
                            <StackPanel Margin="10">
                                <TextBlock Text="Landuse area unit" Style="{StaticResource GroupLabel}"/>
                                <ComboBox ItemsSource="{Binding AreaUnitOptions}"
                                          SelectedItem="{Binding SelectedAreaUnit, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Storm distribution" Style="{StaticResource GroupLabel}"/>
                                <ComboBox ItemsSource="{Binding StormDistributionOptions}"
                                          SelectedItem="{Binding SelectedStormDistribution, Mode=TwoWay}"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="Hydrograph time step (min)" Style="{StaticResource GroupLabel}"/>
                                <TextBox Text="{Binding HydrographTimeStepMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,16"/>

                                <Button Content="Save to drawing"
                                        Command="{Binding SaveToDrawingCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>
                                <Button Content="Save as default"
                                        Command="{Binding SaveAsDefaultCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>
                                <Button Content="Save to drawing &amp; set as default"
                                        Command="{Binding SaveToDrawingAndSetAsDefaultCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ─── COMMANDS TAB ─── -->
                        <DataTemplate x:Key="CommandsTab">
                            <StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="RUN COMMAND" Style="{StaticResource SectionLabel}"
                                               Margin="0,0,0,10"/>

                                    <Button Command="{Binding RunBasinLanduseCommand}"
                                            Style="{StaticResource CommandButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="BASINLANDUSE" Style="{StaticResource CommandText}"/>
                                            <TextBlock Text="Calculate CN from hatch intersections"
                                                       Style="{StaticResource CommandDesc}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RunSplitBasinsCommand}"
                                            Style="{StaticResource CommandButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="SPLITBASINS" Style="{StaticResource CommandText}"/>
                                            <TextBlock Text="Split basins using masks (generate geometry)"
                                                       Style="{StaticResource CommandDesc}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RunHydroModelCommand}"
                                            Style="{StaticResource CommandButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="RUN_HYDRO_MODEL" Style="{StaticResource CommandText}"/>
                                            <TextBlock Text="Export basin model and run the hydrology engine"
                                                       Style="{StaticResource CommandDesc}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding TagBasinCommand}"
                                            Style="{StaticResource CommandButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="TAGBASIN" Style="{StaticResource CommandText}"/>
                                            <TextBlock Text="Tag selected basin polyline"
                                                       Style="{StaticResource CommandDesc}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding GetBasinCommand}"
                                            Style="{StaticResource CommandButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="GETBASIN" Style="{StaticResource CommandText}"/>
                                            <TextBlock Text="Read basin attributes from drawing"
                                                       Style="{StaticResource CommandDesc}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding LabelBasinCommand}"
                                            Style="{StaticResource CommandButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="LABELBASIN" Style="{StaticResource CommandText}"/>
                                            <TextBlock Text="Place basin label annotation"
                                                       Style="{StaticResource CommandDesc}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Border BorderBrush="{StaticResource Separator}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <TextBlock TextWrapping="Wrap" FontSize="10"
                                               Foreground="{StaticResource TextDim}">
                                        Commands can also be typed directly in the AutoCAD command line.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </DataTemplate>

                    </ContentControl.Resources>

                    <!-- Tab content switcher -->
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Basins">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource BasinsTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Landuses">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource LandusesTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Hydrographs">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource HydrographsTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Ponds">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource PondsTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Results">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource ResultsTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Masks">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource MasksTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource SettingsTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Commands">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource CommandsTab}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>
